# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit rules for common file types
*.java     text eol=lf
*.xml      text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.json     text eol=lf
*.properties text eol=lf

# Windows-specific text files (keep CRLF)
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Binary files (no line ending conversion)
*.jar      binary
*.class    binary
*.png      binary
*.jpg      binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.zip      binary

# Data files (keep CRLF if edited on Windows)
data/**    text eol=crlf
